# Pins of the FPGC board (Cyclone IV EP4CE40F23), for the top level fpgc.
# Taken from FPGC-reference's FPGC.qsf: the board is the same. Every pin is
# 3.3-V LVTTL.

set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"

# Clocks
set_location_assignment PIN_T2 -to sys_clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sys_clk_50
set_location_assignment PIN_AA12 -to sys_clk_header
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sys_clk_header

