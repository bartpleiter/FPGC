set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_uart_rx
set_location_assignment PIN_Y1 -to led_uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_uart_tx
set_location_assignment PIN_V1 -to led_usb
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_usb
set_location_assignment PIN_W1 -to led_user
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_user

# Reset button
set_location_assignment PIN_Y2 -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n

# Display header
set_location_assignment PIN_AB13 -to disp[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[1]
set_location_assignment PIN_AB14 -to disp[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[2]
set_location_assignment PIN_AB15 -to disp[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[3]
set_location_assignment PIN_AA13 -to disp[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[4]
set_location_assignment PIN_AA14 -to disp[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[5]
set_location_assignment PIN_AA15 -to disp[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to disp[6]

# GPIO header
set_location_assignment PIN_AB16 -to gpio[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[1]
set_location_assignment PIN_AA16 -to gpio[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[2]
set_location_assignment PIN_AB17 -to gpio[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[3]
set_location_assignment PIN_AA17 -to gpio[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[4]
set_location_assignment PIN_AB18 -to gpio[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[5]
set_location_assignment PIN_AA18 -to gpio[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[6]
set_location_assignment PIN_AB19 -to gpio[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[7]
set_location_assignment PIN_AA19 -to gpio[8]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[8]
set_location_assignment PIN_AB20 -to gpio[9]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to gpio[9]

# The PLL at PLL 2, whose dedicated clock output is SDRAM_CLK's pin (B20)
set_location_assignment PLL_2 -to "system_pll:pll|altpll:pll|altpll_oi72:auto_generated|pll1"
